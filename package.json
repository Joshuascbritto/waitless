{
  "name": "waitless",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @waitless/db db:generate",
    "db:migrate": "pnpm --filter @waitless/db db:migrate",
    "vapid:generate": "pnpm --filter @waitless/api vapid:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
