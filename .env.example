# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Read by: docker compose (POSTGRES_*, *_PORT) and the API (`pnpm dev` loads it via --env-file).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# Interface and port Fastify listens on.
API_HOST=0.0.0.0
API_PORT=3001
# The only origin allowed to make state-changing requests (CSRF Origin check, SPEC §9).
# This is the web app's origin, since the browser reaches the API through it.
APP_ORIGIN=http://localhost:3000
# Which proxies may set X-Forwarded-For, so request.ip is the real client
# (used by rate limits). "loopback" trusts the local Next.js dev proxy only.
# Accepts Fastify's trustProxy values: a hop count, or comma-separated IPs/CIDRs/keywords.
TRUST_PROXY=loopback
# Serve the OpenAPI document and Swagger UI at /api/docs. true in development
# and the public demo; leave false in production.
API_DOCS=true

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Where Next.js proxies /api/* in development (same-origin routing, SPEC §4).
# Next.js does not read this root .env; the default below applies unless you
# export API_ORIGIN in the shell that runs `pnpm dev`.
API_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ---------------------------------------------------------------------------
# Superuser created by the Postgres container on first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waitless
# Host port mapped to the container's 5432.
POSTGRES_PORT=5432
# Passwords for the two roles created by deploy/docker/postgres/initdb/10-roles.sh.
# Only applied when the volume is first created.
WAITLESS_OWNER_PASSWORD=owner
WAITLESS_APP_PASSWORD=app
# The API and worker connect as waitless_app: no BYPASSRLS, owns nothing, so
# row-level security always applies (SPEC §9).
DATABASE_URL=postgres://waitless_app:app@localhost:5432/waitless
# Migrations connect as waitless_owner, which owns the tables (`pnpm db:migrate`).
MIGRATION_DATABASE_URL=postgres://waitless_owner:owner@localhost:5432/waitless

# ---------------------------------------------------------------------------
# Redis (docker compose): pub/sub, rate limits, BullMQ
# ---------------------------------------------------------------------------
# Host port mapped to the container's 6379.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Mailpit (docker compose): catches outgoing email locally (v1.1)
# ---------------------------------------------------------------------------
# SMTP port the app will send to, and the web UI at http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
