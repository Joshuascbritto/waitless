# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Read by: docker compose (POSTGRES_*, *_PORT) and the API (`pnpm dev` loads it via --env-file).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# Interface and port Fastify listens on.
API_HOST=0.0.0.0
API_PORT=3001

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Where Next.js proxies /api/* in development (same-origin routing, SPEC §4).
# Next.js does not read this root .env; the default below applies unless you
# export API_ORIGIN in the shell that runs `pnpm dev`.
API_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ---------------------------------------------------------------------------
# Superuser created by the Postgres container on first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waitless
# Host port mapped to the container's 5432.
POSTGRES_PORT=5432
# Connection string the API uses. Phase 0 uses the superuser; Phase 1 switches
# the API to the non-owner role waitless_app so RLS applies (SPEC §9).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waitless

# ---------------------------------------------------------------------------
# Redis (docker compose): pub/sub, rate limits, BullMQ
# ---------------------------------------------------------------------------
# Host port mapped to the container's 6379.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Mailpit (docker compose): catches outgoing email locally (v1.1)
# ---------------------------------------------------------------------------
# SMTP port the app will send to, and the web UI at http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
