# Copy to secrets.env (gitignored) or set the matching GitHub Actions secrets.
# Passwords must match postgres.env.
DATABASE_URL=postgres://waitless_app:CHANGE_ME_APP@postgres:5432/waitless
REDIS_URL=redis://redis:6379
MIGRATION_DATABASE_URL=postgres://waitless_owner:CHANGE_ME_OWNER@postgres:5432/waitless
# `pnpm vapid:generate`; leave all three out to run without push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
