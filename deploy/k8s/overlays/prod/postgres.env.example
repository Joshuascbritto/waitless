# Copy to postgres.env (gitignored). The superuser password is only used by the
# Postgres StatefulSet and the bootstrap-roles Job; the app never sees it.
PGHOST=postgres
PGPASSWORD=CHANGE_ME_SUPERUSER
POSTGRES_USER=postgres
POSTGRES_DB=waitless
WAITLESS_OWNER_PASSWORD=CHANGE_ME_OWNER
WAITLESS_APP_PASSWORD=CHANGE_ME_APP
